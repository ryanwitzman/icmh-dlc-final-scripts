import os

configfile: "../configs/config.yaml"

# --- 1. SETUP PATHS ---
# Update this to your actual input directory
INPUT_DIR = "../inputs" 
OUTPUT_DIR = "../outputs"

# --- 2. FIND FILES AND CREATE MAPPING ---
raw_files = [
    os.path.join(dirpath, f)
    for dirpath, dirnames, files in os.walk(INPUT_DIR)
    for f in files if f.lower().endswith('.mp4')
]

PATH_MAP = { os.path.basename(f): f for f in raw_files }


# --- 3. RULES ---

rule all:
    input:
        expand(f"{OUTPUT_DIR}/trimmed_{{vid}}", vid=PATH_MAP.keys())

rule trim_video:
    input:
        lambda wildcards: PATH_MAP[wildcards.vid]
    output:
        f"{OUTPUT_DIR}/trimmed_{{vid}}"
    script:
        "../src/trim/trim_video.py"